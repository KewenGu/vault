# 复制为 .env.local 并填入真实值。

# ---- 必填 ----
# Supabase：数据库、登录、文件存储。本地用 `npx supabase start` 起一套，地址和密钥看 `npx supabase status`。
# 密钥新旧两种都能用（都实测过）：
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  填 Publishable key（sb_publishable_…），或旧式的 anon key（eyJ…）
#   SUPABASE_SERVICE_ROLE_KEY      填 Secret key（sb_secret_…），或旧式的 service_role key（eyJ…）
# 第二个能绕过行级安全读写所有人的数据：只放在服务器上，不要提交、不要发给别人。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Claude：读懂内容（看图、概括、分类、提实体）
ANTHROPIC_API_KEY=

# ---- 建议配 ----
# Voyage AI 向量（voyageai.com）：语义搜索、图谱里「是不是同一个东西」的判断。不配 = 只能按关键词搜，图谱只按名字归并。
VOYAGE_API_KEY=
# 只让这些邮箱用这个站（逗号分隔）。不配 = 能登录的账号都能用。自用部署到公网时一定要配。
VAULT_ALLOWED_EMAILS=
# iPhone 上「分享到 Vault」的快捷指令的 iCloud 链接（https://www.icloud.com/shortcuts/…）。配了之后「手机」页上有「安装快捷指令」按钮。
# 快捷指令要先在 iPhone 上照「手机」页的步骤做一次，再长按它 → Share → Copy iCloud Link 拿到链接。不配 = 页面上只有手动步骤。
# VAULT_IOS_SHORTCUT_URL=

# ---- 语音识别（视频口播、音频）：三选一或都配，按顺序试 ----
# 豆包语音识别（火山引擎控制台开通「录音文件识别」）
# VOLC_SPEECH_API_KEY=
# OpenAI whisper-1
# OPENAI_API_KEY=
# 本机的 whisper：命令在 PATH 里、模型文件在就自动用，不用配（见 README「本机工具」）

# ---- 读取平台内容 ----
# Apify（apify.com，按条计费）：抖音、Instagram 的链接靠它读。不配 = 这两个平台的链接读不了（可以手动贴文字）。小红书带口令的链接不用它。
# YouTube 不给这台机器读时（云服务器上）也靠它：一个 actor 读标题、简介和字幕，另一个把视频下下来（看画面、转写口播）。
# APIFY_TOKEN=
# APIFY_DOUYIN_ACTOR=
# APIFY_INSTAGRAM_ACTOR=
# APIFY_YOUTUBE_ACTOR=
# 下 YouTube 视频的 actor（默认 johnvc~youtube-download-api）；设成 off 就不下视频，只读字幕
# APIFY_YOUTUBE_DOWNLOAD_ACTOR=
# 存一个博主的全部作品时，列 TikTok / 抖音 / 小红书 / Instagram / YouTube 账号的作品也靠它
# （默认 clockworks~tiktok-profile-scraper、zen-studio~douyin-profile-scraper、socialdatax~socialdatax-xhs-data-api；
#   Instagram、YouTube 默认用上面读单条的那两个 actor，那两个换了这里跟着换）
# APIFY_TIKTOK_PROFILE_ACTOR=
# APIFY_DOUYIN_PROFILE_ACTOR=
# APIFY_XHS_PROFILE_ACTOR=
# APIFY_INSTAGRAM_PROFILE_ACTOR=
# APIFY_YOUTUBE_PROFILE_ACTOR=
# 小红书笔记的链接里没有访问口令、或者口令过期了，也靠它按笔记 id 读（默认 socialdatax~socialdatax-xhs-data-api）
# APIFY_XHS_ACTOR=
# Jina Reader（jina.ai）：读网页正文。不配也能用（免费额度有限速），配了更稳。
# JINA_API_KEY=
# yt-dlp：别的视频站（B 站、Vimeo…）和 YouTube 读不到时的后备。不填就在 PATH 里找。
# YTDLP_PATH=
# ffmpeg：抽视频画面、导音轨。要 8.1.3 或更新；不填就在 PATH 里找。
# FFMPEG_PATH=

# ---- 可选 ----
# 理解内容用的模型（默认 claude-opus-5-5；想省钱可以换 claude-sonnet-5-5）和思考深度（low / medium / high，默认 medium）
# VAULT_MODEL=
# VAULT_EFFORT=
# 视频原片和上传的文件单个最多存多大（MB，默认 50 = Supabase 免费套餐的上限；付费套餐调高全局上限后可以设到 200）。
# VAULT_STORE_MAX_MB=50
# 为了读懂内容，一个视频最多下载多大（MB，默认 600）。下载到磁盘上的临时目录，读完就删，不进内存。
# 超过存档上限的原片不进 Supabase，留在这台机器的磁盘上，页面从磁盘播放。
# 留在哪个目录（默认是运行目录下的 .vault-media）。不限总量、不自动清理。
# VAULT_LOCAL_MEDIA_DIR=
# VAULT_VIDEO_READ_MAX_MB=600
# 概括、要点、标签用什么语言写：zh（默认）或 en。原话和图里的字始终保留原文。
# VAULT_LANGUAGE=zh
# 处理超过多少分钟还没结束，页面才把它当成卡住了（默认 20；慢机器处理长视频要调大）
# VAULT_STUCK_MINUTES=20
# 存一个博主的作品时一次同时处理几条（默认 2，最多 4；小机器上设成 1）。本地模式下还受 WORKFLOW_LOCAL_QUEUE_CONCURRENCY 管
# VAULT_CREATOR_PARALLEL=2
# 在代理 / fake-IP 环境里读外部内容：设成 trusted-proxy，并配好 HTTPS_PROXY
# PUBLIC_EGRESS_MODE=trusted-proxy
