# 复制为 deploy/.env 并填入真实值（这个文件不要提交）。

# ---- 域名 ----
# 浏览器里访问的域名，要先解析到这台服务器。没有自己的域名可以用 sslip.io：
# 服务器 IP 是 1.2.3.4 就填 1-2-3-4.sslip.io（它会解析回这个 IP，Caddy 照样能申请到证书）。
VAULT_DOMAIN=

# ---- 必填 ----
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key（sb_publishable_…），或旧式的 anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key（sb_secret_…），或旧式的 service_role key。能读写所有人的数据，只放在这台服务器上。
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# 只让这些邮箱用这个站（逗号分隔）。放到公网上一定要填。
VAULT_ALLOWED_EMAILS=

# ---- 建议配 ----
VOYAGE_API_KEY=
# 语音转写：任选其一（服务器上没有本机 whisper）
# OPENAI_API_KEY=
# VOLC_SPEECH_API_KEY=
# 读抖音、Instagram；服务器上读 YouTube 也靠它（YouTube 不给机房 IP 直接读）
# APIFY_TOKEN=
# JINA_API_KEY=

# ---- 这台机器的大小（下面是按 1 核 2 GB 内存给的值）----
# 为了读懂内容，一个视频最多下载多大（MB，默认 600）。下载到容器里的临时目录，读完就删，不进内存；
# 磁盘要留得出「这个数 × 同时处理的条数」。以前这里写的是 250（那时候整个文件读进内存），现在不用设。
# 超过存档上限（默认 50 MB）的原片读完不删，留在卷里的 /data/media，一直攒着，磁盘要自己看着（「状态」页有占用）。
# VAULT_VIDEO_READ_MAX_MB=600
# 处理超过这么多分钟还没结束，页面才把它当成卡住了。1 核的机器处理长视频（下载、抽画面、转写）慢，给得宽一点。
VAULT_STUCK_MINUTES=60
# 同时处理几条内容。1 核 2 GB 一次一条，多了内存不够。
WORKFLOW_LOCAL_QUEUE_CONCURRENCY=2
# 应用容器的内存上限
# VAULT_MEM_LIMIT=1700m

# ---- 可选 ----
# VAULT_MODEL=
# VAULT_EFFORT=
# VAULT_LANGUAGE=zh
# VAULT_STORE_MAX_MB=50
